# Local only: one-click "sign in as" panel on /login. Ignored unless `next dev` + local Supabase,
# so it can never switch on in production.
DEV_LOGIN=

# CoachOS mailbox (Gmail API): Google Cloud → OAuth client (Web), consent screen "Internal".
# Redirect URI: <app URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_INBOX_ADDRESS=coachos@aliveandfreeconsulting.com
# Encrypts the stored Gmail token: openssl rand -base64 32
MAIL_TOKEN_KEY=
